{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Default Worker: production.
  // Staging must always be deployed explicitly with:
  //   npx wrangler deploy --env staging
  "name": "mdtech-loja",

  // Main entry point — custom worker that wraps OpenNext and adds scheduled handler
  "main": "custom-worker.ts",

  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-04-01",

  // Static assets shared by both environments.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Observability shared by both environments.
  "observability": {
    "enabled": true
  },

  // Cron deliberately disabled for S38.2.
  // S38.3 will configure the actual reservation-expiry schedule.
  "triggers": {
    "crons": []
  },

  // ---------------------------------------------------------------------------
  // PRODUCTION — mdtech-loja
  // ---------------------------------------------------------------------------
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9c4d0587f9b840fe9bed8b4beba8a167"
    }
  ],

  "vars": {
    "NODE_ENV": "production"
  },

  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "mdtech-production"
    }
  ],

  "services": [
    {
      "binding": "ALSO_SFTP_FETCHER",
      "service": "also-sftp-fetcher"
    }
  ],

  // ---------------------------------------------------------------------------
  // STAGING — mdtech-staging
  // ---------------------------------------------------------------------------
  "env": {
    "staging": {
      "name": "mdtech-staging",

      "vars": {
        "NODE_ENV": "production"
      },

      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "04d318e1eafa44d7becfabe756c11d20"
        }
      ],

      "r2_buckets": [
        {
          "binding": "PRODUCT_IMAGES",
          "bucket_name": "mdtech-staging"
        }
      ],

      "services": [
        {
          "binding": "ALSO_SFTP_FETCHER",
          "service": "also-sftp-fetcher"
        }
      ]
    }
  }

  // Secrets remain outside this file and are managed with:
  //   wrangler secret put ...
  //
  // Production and staging secrets must be managed independently.
}
