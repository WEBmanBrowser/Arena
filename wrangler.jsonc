{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdtech-loja",

  // Main entry point — custom worker that wraps OpenNext and adds scheduled handler
  // The custom-worker.ts is compiled alongside .open-next/worker.js
  "main": "custom-worker.ts",

  // Required for Node.js API compatibility (pg, crypto, buffer, etc.)
  "compatibility_flags": ["nodejs_compat"],

  // Use a recent compatibility date for best process.env support
  "compatibility_date": "2025-04-01",

  // Static assets binding
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Hyperdrive binding for Neon PostgreSQL (staging configuration: mdtech-staging).
  // The binding name HYPERDRIVE is required by src/db/index.ts.
  // No localConnectionString and no credentials are stored here: for local
  // development set DATABASE_URL in .env instead (see src/db/index.ts).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "04d318e1eafa44d7becfabe756c11d20"
    }
  ],

  // Environment variables (non-secret)
  "vars": {
    "NODE_ENV": "production"
  },

  // R2 bucket for product images (staging bucket: mdtech-staging).
  // The binding name PRODUCT_IMAGES is required by src/lib/storage/r2.ts.
  // Public access is NOT enabled; R2_PUBLIC_URL stays unset until a public
  // domain is deliberately configured (getPublicUrl() then returns null).
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "mdtech-staging"
    }
  ],

  // Observability
  "observability": {
    "enabled": true
  },

  // Cron Trigger — expire pending order reservations every 10 minutes
  "triggers": {
    "crons": ["*/10 * * * *"]
  }

  // SECRETS (set via `wrangler secret put` — NEVER stored in this file):
  // Required before the first staging deploy:
  // - JWT_SECRET             (sessions; auth throws without it)
  // - CRON_SECRET            (REQUIRED for cron; there is no JWT_SECRET fallback)
  // Required only for the features that use them:
  // - BULK_PREVIEW_SECRET    (>=32 chars; admin bulk price preview)
  // - EUPAGO_API_KEY / EUPAGO_OAUTH_CLIENT_ID / EUPAGO_OAUTH_CLIENT_SECRET /
  //   EUPAGO_WEBHOOK_KEY     (Eupago payments + webhook verification)
  // - EMAIL_API_KEY          (outbound email; without it emails are logged, not sent)
  // Optional non-secret vars: EUPAGO_ENVIRONMENT (default sandbox), EMAIL_FROM,
  // NEXT_PUBLIC_SITE_URL / SITE_URL, ORDER_RESERVATION_MINUTES, R2_PUBLIC_URL.
}
